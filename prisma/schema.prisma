generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  companies Company[]
  contacts  Contact[]
  sessions  Session[]
  goals     Goal[]
}

model Company {
  id       String    @id @default(cuid())
  userId   String
  name     String
  tier     Tier      @default(B)
  notes    String?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@unique([userId, name])
}

model Contact {
  id          String     @id @default(cuid())
  userId      String
  companyId   String?
  fullName    String
  title       String?
  linkedinUrl String?
  affinity    Affinity[]
  stage       Stage      @default(NOT_CONTACTED)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  outreach    Outreach[]

  @@index([userId, stage])
}

model Outreach {
  id         String    @id @default(cuid())
  contactId  String
  channel    Channel
  sentAt     DateTime  @default(now())
  body       String?
  repliedAt  DateTime?
  followUpOn DateTime?
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  startedAt DateTime @default(now())
  minutes   Int      @default(120)
  actions   Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id     String   @id @default(cuid())
  userId String
  weekOf DateTime
  target Int
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekOf])
}

enum Tier {
  A
  B
  C
}

enum Stage {
  NOT_CONTACTED
  EMAILED
  REPLIED
  CALL_SCHEDULED
  CALL_DONE
  THANKED
  REFERRED
}

enum Affinity {
  ALUMNI
  MAJOR
  HOMETOWN
  HOBBY
  OTHER
}

enum Channel {
  EMAIL
  LINKEDIN
  CALL
}
